#!/usr/bin/env bash
set -euo pipefail

# DMS ships its settings as a per-user file. Seed only a missing file so a
# fresh account gets secure native idle locking without replacing user state.
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
settings_dir="$config_home/DankMaterialShell"
settings="$settings_dir/settings.json"
if [[ ! -e "$settings" && ! -L "$settings" ]]; then
    mkdir -p "$settings_dir"
    temporary=$(mktemp "$settings_dir/.settings.json.XXXXXX")
    trap 'rm -f "$temporary"' EXIT
    chmod 600 "$temporary"
    cat >"$temporary" <<'JSON'
{
  "acMonitorTimeout": 360,
  "acLockTimeout": 300,
  "batteryMonitorTimeout": 360,
  "batteryLockTimeout": 300
}
JSON
    # A hard-link install cannot overwrite a concurrent user-created file.
    if ! ln "$temporary" "$settings" 2>/dev/null; then
        if [[ ! -e "$settings" && ! -L "$settings" ]]; then
            echo "Unable to initialize DankMaterialShell settings: $settings" >&2
            exit 1
        fi
    fi
    rm -f "$temporary"
    trap - EXIT
fi

exec /usr/bin/dms run
