configuration {
    show-icons: true;
}

* {
    font: "JetBrainsMono Nerd Font 10";
    background: #1e1e2eff;
    background-alt: #313244ff;
    foreground: #cdd6f4ff;
    selected: #cba6f7ff;
    urgent: #f38ba8ff;
    border-color: #45475aff;
}

window {
    width: 42%;
    border: 2px;
    border-radius: 8px;
    padding: 12px;
    background-color: @background;
}

mainbox { spacing: 10px; }
inputbar {
    padding: 8px 10px;
    border-radius: 6px;
    background-color: @background-alt;
    text-color: @foreground;
}
listview { spacing: 4px; lines: 10; }
element { padding: 7px 9px; border-radius: 6px; }
element normal normal { text-color: @foreground; }
element selected normal { background-color: @selected; text-color: @background; }
element urgent normal { text-color: @urgent; }
element-icon { size: 1.2em; margin: 0 8px 0 0; }
